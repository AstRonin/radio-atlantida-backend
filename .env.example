# Development values. Copy to .env (never committed) and adjust if needed.
# Variables already set in the shell take precedence over this file.

# --- Backend (read by `make run`) ---
DATABASE_URL=postgres://radio:radio@localhost:5432/radio?sslmode=disable
MEDIA_ROOT=./.dev/media
LOG_ROOT=./.dev/logs
# Liquidsoap's playout journal (written by the dev stack, read for reconciliation).
PLAYOUT_JOURNAL_ROOT=./.dev/journal
HTTP_ADDR=127.0.0.1:8090
# Live voice (WebRTC): the UDP port of the bridge, and the addresses on which
# the browser reaches it (empty: the host's interface addresses).
LIVE_UDP_ADDR=127.0.0.1:8189
LIVE_PUBLIC_IPS=

# --- Secrets (shared by the backend and the dev stack) ---
ICECAST_SOURCE_PASSWORD=dev-source-pass
LIQUIDSOAP_CONTROL_USER=source
LIQUIDSOAP_CONTROL_PASSWORD=dev-control-pass

# --- Dev stack only (docker-compose.dev.yml) ---
POSTGRES_USER=radio
POSTGRES_PASSWORD=radio
POSTGRES_DB=radio
ICECAST_ADMIN_USERNAME=admin
ICECAST_ADMIN_PASSWORD=dev-admin-pass
ICECAST_RELAY_PASSWORD=dev-relay-pass
# Grafana (make monitoring-up): port on 127.0.0.1, the admin login (applied
# only when Grafana's volume is created; make monitoring-reset), and the
# password of the read-only database role grafana_ro.
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=dev-grafana-pass
GRAFANA_DB_PASSWORD=dev-grafana-db-pass
# Where Liquidsoap sends track start/end callbacks. The default reaches a
# backend started on the host with `make run`. With `--profile app`, use
# http://backend:8090/api/playout/callback.
BACKEND_CALLBACK_URL=http://host.docker.internal:8090/api/playout/callback
# Where Liquidsoap asks for an emergency track when the plan has nothing.
BACKEND_EMERGENCY_URL=http://host.docker.internal:8090/api/playout/emergency/next
